{
  "manifest_version": 2,
  "name": "__MSG_extension_name__",
  "version": "0.1.8",
  "description": "__MSG_extension_description__",
  "default_locale": "zh_TW",
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "background": {
    "scripts": [
      "capture-plan.js",
      "i18n.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "__MSG_browser_action_title__",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/capture.svg"
  },
  "icons": {
    "48": "icons/capture.svg",
    "96": "icons/capture.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "full-web-page-screenshot@henry-jia.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "homepage_url": "https://github.com/henry-jia/full-web-page-screenshot"
}
